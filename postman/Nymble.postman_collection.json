{
  "info": {
    "name": "Nymble API",
    "description": "Run folders in order. Login requests save JWTs and the Nymble token into collection variables. Start the API on http://localhost:5000 and run `npm run seed` first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"email\": \"postman_user@test.local\",\n  \"password\": \"Passw0rd!x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates an account, a Nymble ID and a first token. Saves them as collection variables. Change the email if it already exists (or run the seed again)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created',()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "pm.collectionVariables.set('userJwt', j.token);",
                  "pm.collectionVariables.set('nymbleToken', j.nymbleToken);",
                  "pm.collectionVariables.set('nymbleId', j.user.nymbleId);",
                  "pm.test('no password leaked',()=>pm.expect(JSON.stringify(j)).to.not.include('passwordHash'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as demo user (alice)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@nymble.local\",\n  \"password\": \"Demo@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userJwt', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nymble.local\",\n  \"password\": \"Admin@12345\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK',()=>pm.response.to.have.status(200));",
                  "pm.test('role is admin',()=>pm.expect(pm.response.json().user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminJwt', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with wrong password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@nymble.local\",\n  \"password\": \"wrong-pass1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with invalid data (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"x\",\n  \"email\": \"nope\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 with field errors',()=>{pm.response.to.have.status(400);pm.expect(pm.response.json().fields).to.be.an('object');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Pseudonym Manager (user)",
      "item": [
        {
          "name": "My pseudonym",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pseudonym/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pseudonym",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));",
                  "pm.test('exposes no email',()=>pm.expect(pm.response.json()).to.not.have.property('email'));",
                  "pm.collectionVariables.set('nymbleId', pm.response.json().nymbleId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Issue / rotate token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pseudonym/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pseudonym",
                "token"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "Revokes the previous active token and returns a new raw token once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201',()=>pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('nymbleToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke my token",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pseudonym/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pseudonym",
                "token"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Anonymous service access",
      "item": [
        {
          "name": "List services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/service/resources",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "resources"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request access (token header)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Nymble-Token",
                "value": "{{nymbleToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service/access",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "access"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource\": \"whisper-board\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sends X-Nymble-Token. 200 when the token is valid, 401 for missing/invalid/expired/revoked, 403 when blacklisted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('granted or denied with a clear code',()=>{const c=pm.response.code;pm.expect([200,401,403]).to.include(c);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Post under pseudonym",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Nymble-Token",
                "value": "{{nymbleToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/service/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resource\": \"whisper-board\",\n  \"body\": \"Hello from Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 when allowed',()=>pm.expect([201,401,403]).to.include(pm.response.code));",
                  "if(pm.response.code===201){pm.collectionVariables.set('postId', pm.response.json().post.id);}"
                ]
              }
            }
          ]
        },
        {
          "name": "Access with a bad token (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }

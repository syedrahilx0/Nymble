    {
      "name": "4. Reports",
      "item": [
        {
          "name": "Report a Nymble ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetNymbleId\": \"{{targetNymbleId}}\",\n  \"category\": \"spam\",\n  \"description\": \"Posting promotional links repeatedly.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            },
            "description": "Set the targetNymbleId collection variable first (copy one from the admin Users list). You cannot report yourself."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409 if already open',()=>pm.expect([201,409]).to.include(pm.response.code));"
                ]

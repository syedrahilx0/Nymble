# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
NODE_ENV=development

# Local MongoDB, or paste a free MongoDB Atlas (M0) connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nymble

# Signs login sessions (JWT). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Secret used to derive Nymble IDs from user ids (HMAC). Keep it private.
NYMBLE_SECRET=replace-with-another-long-random-string

# How long a Nymble token stays valid before it must be renewed
TOKEN_TTL_MINUTES=60

# Allowed browser origin(s) for CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173
